{
  "tuiMode": "fullscreen",
  "transport": "sse",
  "steeringMode": "all",
  "packages": [
    {
      "source": "npm:pi-subagents",
      "extensions": []
    },
    "npm:pi-web-access",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-multi-pass",
    "npm:pi-system-theme",
    "npm:pi-powerline-footer",
    "npm:pi-verbosity-control",
    "npm:pi-codebase-memory-mcp",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": []
    },
    "../browser-runtime",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@plannotator/pi-extension",
    "https://github.com/sting8k/pi-vcc"
  ],
  "subagents": {
    "agentOverrides": {
      "worker": {
        "thinking": "high",
        "tools": "inherit",
        "inheritSkills": true
      },
      "reviewer": {
        "thinking": "xhigh",
        "tools": "inherit",
        "inheritSkills": true
      },
      "planner": {
        "thinking": "xhigh",
        "tools": "inherit",
        "inheritSkills": true
      },
      "oracle": {
        "thinking": "xhigh",
        "tools": "inherit",
        "inheritSkills": true
      },
      "scout": {
        "thinking": "medium",
        "tools": "inherit",
        "inheritSkills": true
      },
      "context-builder": {
        "thinking": "medium",
        "tools": "inherit",
        "inheritSkills": true
      },
      "researcher": {
        "thinking": "medium",
        "tools": "inherit",
        "inheritSkills": true
      },
      "delegate": {
        "thinking": "low",
        "tools": "inherit",
        "inheritSkills": true
      }
    },
    "agentOverridesByProvider": {
      "anthropic": {
        "worker": {
          "model": "anthropic/claude-opus-5-5"
        },
        "reviewer": {
          "model": "anthropic/claude-opus-5-5"
        },
        "planner": {
          "model": "anthropic/claude-opus-5-5"
        },
        "oracle": {
          "model": "anthropic/claude-opus-5-5"
        },
        "scout": {
          "model": "anthropic/claude-sonnet-5-5"
        },
        "context-builder": {
          "model": "anthropic/claude-sonnet-5-5"
        },
        "researcher": {
          "model": "anthropic/claude-sonnet-5-5"
        },
        "delegate": {
          "model": "anthropic/claude-sonnet-5-5"
        }
      },
      "openai-codex": {
        "worker": {
          "model": "openai-codex/gpt-6.1-sol"
        },
        "reviewer": {
          "model": "openai-codex/gpt-6.1-sol"
        },
        "planner": {
          "model": "openai-codex/gpt-6.1-sol"
        },
        "oracle": {
          "model": "openai-codex/gpt-6.1-sol"
        },
        "scout": {
          "model": "openai-codex/gpt-6-luna"
        },
        "context-builder": {
          "model": "openai-codex/gpt-6-luna"
        },
        "researcher": {
          "model": "openai-codex/gpt-6-luna"
        },
        "delegate": {
          "model": "openai-codex/gpt-6-luna"
        }
      }
    }
  },
  "powerline": {
    "welcome": false,
    "fixedEditor": false
  }
}
