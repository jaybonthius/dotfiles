{
  "tuiMode": "fullscreen",
  "transport": "sse",
  "steeringMode": "all",
  "packages": [
    {
      "source": "npm:pi-subagents",
      "extensions": []
    },
    "npm:pi-web-access",
    "npm:pi-system-theme",
    "npm:pi-powerline-footer",
    "npm:pi-verbosity-control",
    "npm:pi-codebase-memory-mcp",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": []
    },
    "../browser-runtime",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@plannotator/pi-extension",
    "https://github.com/sting8k/pi-vcc"
  ],
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "tools": "inherit",
        "inheritSkills": true
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "xhigh",
        "tools": "inherit",
        "inheritSkills": true
      },
      "planner": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "xhigh",
        "tools": "inherit",
        "inheritSkills": true
      },
      "oracle": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "xhigh",
        "tools": "inherit",
        "inheritSkills": true
      },
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "tools": "inherit",
        "inheritSkills": true
      },
      "context-builder": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "tools": "inherit",
        "inheritSkills": true
      },
      "researcher": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "tools": "inherit",
        "inheritSkills": true
      },
      "delegate": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low",
        "tools": "inherit",
        "inheritSkills": true
      }
    }
