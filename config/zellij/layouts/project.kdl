// Project layout for zellij
// Usage: ws <directory> [session-name]
//
// Tab 1: emacsclient connected to the Emacs daemon
// Tab 2: pi coding agent
// Tab 3: terminal

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    new_tab_template {
        pane
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    tab name="editor" focus=true {
        pane command="emacsclient" {
            args "-t"
        }
    }

    tab name="pi" {
        pane command="pi"
    }

    tab name="terminal" {
        pane
    }
}
