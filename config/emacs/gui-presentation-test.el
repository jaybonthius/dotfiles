;;; gui-presentation-test.el --- Presentation isolation tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'org)
(load (expand-file-name "gui-presentation.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)

(ert-deftest jb-gui-profile-requires-only-graphical-visible-frames ()
  (cl-letf (((symbol-function 'frame-list) (lambda () '(gui daemon)))
            ((symbol-function 'frame-visible-p) (lambda (f) (not (eq f 'daemon))))
            ((symbol-function 'display-graphic-p) (lambda (f) (eq f 'gui))))
    (should (jb-gui-presentation-eligible-p)))
  (cl-letf (((symbol-function 'frame-list) (lambda () '(gui tty)))
            ((symbol-function 'frame-visible-p) (lambda (_) t))
            ((symbol-function 'display-graphic-p) (lambda (f) (eq f 'gui))))
    (should-not (jb-gui-presentation-eligible-p))
    (should (jb-gui-presentation-eligible-p 'tty))
    (should-not (jb-gui-presentation-eligible-p 'gui)))
  (cl-letf (((symbol-function 'frame-list) (lambda () nil)))
    (should-not (jb-gui-presentation-eligible-p))))

(ert-deftest jb-org-typography-restores-buffer-settings ()
  (with-temp-buffer
    (org-mode)
    (setq-local line-spacing 0.3)
    (face-remap-add-relative 'default :height 1.2)
    (let ((before (copy-tree face-remapping-alist)))
      (jb-org-gui-typography-mode 1)
      (should (= line-spacing 0.15))
      (should (memq 'variable-pitch (cdr (assq 'default face-remapping-alist))))
      (dolist (face '(org-block org-code org-verbatim org-table))
        (should (memq 'fixed-pitch (cdr (assq face face-remapping-alist)))))
      (let ((cookies (copy-sequence jb-org-gui--remappings)))
        (jb-org-gui-typography-mode 1)
        (should (equal cookies jb-org-gui--remappings)))
      (jb-org-gui-typography-mode -1)
      (should (= line-spacing 0.3))
      (should (local-variable-p 'line-spacing))
      (should (equal before face-remapping-alist)))))

(ert-deftest jb-org-typography-restores-inherited-spacing ()
  (with-temp-buffer
    (org-mode)
    (kill-local-variable 'line-spacing)
    (jb-org-gui-typography-mode 1)
    (jb-org-gui-typography-mode -1)
    (should-not (local-variable-p 'line-spacing))))

(ert-deftest jb-org-typography-keeps-subsequent-user-spacing ()
  (with-temp-buffer
    (org-mode)
    (jb-org-gui-typography-mode 1)
    (setq-local line-spacing 0.4)
    (jb-org-gui-typography-mode -1)
    (should (= line-spacing 0.4))))

(ert-deftest jb-org-switches-prettifiers-without-overlap ()
  (with-temp-buffer
    (org-mode)
    (setq-local org-superstar-mode t)
    (setq-local org-modern-mode nil)
    (cl-letf (((symbol-function 'org-superstar-mode)
               (lambda (arg)
                 (when (> arg 0) (should-not org-modern-mode))
                 (setq org-superstar-mode (> arg 0))))
              ((symbol-function 'org-modern-mode)
               (lambda (arg)
                 (when (> arg 0) (should-not org-superstar-mode))
                 (setq org-modern-mode (> arg 0)))))
      (let ((jb-gui-presentation-active t))
        (jb-org-apply-presentation)
        (should org-modern-mode)
        (should-not org-superstar-mode)
        (should jb-org-gui-typography-mode))
      (let ((jb-gui-presentation-active nil))
        (jb-org-apply-presentation)
        (should org-superstar-mode)
        (should-not org-modern-mode)
        (should-not jb-org-gui-typography-mode)))))

(ert-deftest jb-markdown-selector-precedes-markdown-autoload ()
  (let ((auto-mode-alist '(("\\.md\\'" . markdown-mode))))
    (jb-markdown-register-mode)
    (add-to-list 'auto-mode-alist
                 '("\\.\\(md\\|markdown\\)\\'" . markdown-mode))
    (jb-markdown-register-mode)
    (should (eq (cdar auto-mode-alist) 'jb-markdown-select-mode))
    (should (= (length (cl-remove-if-not
                        (lambda (entry) (eq (cdr entry) 'jb-markdown-select-mode))
                        auto-mode-alist)) 1))))

(ert-deftest jb-markdown-mode-selection-follows-frames ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/README.md")
    (let ((gui t) (calls nil))
      (cl-letf (((symbol-function 'jb-gui-presentation-eligible-p)
                 (lambda (&optional _) gui))
                ((symbol-function 'markdown-modern-mode)
                 (lambda () (push 'modern calls) (setq major-mode 'markdown-modern-mode)))
                ((symbol-function 'gfm-mode)
                 (lambda () (push 'gfm calls) (setq major-mode 'gfm-mode)))
                ((symbol-function 'markdown-mode)
                 (lambda () (push 'markdown calls) (setq major-mode 'markdown-mode))))
        (jb-markdown-select-mode)
        (should (eq major-mode 'markdown-modern-mode))
        (let ((jb-gui-presentation-active t))
          (jb-markdown-apply-presentation)
          (should (equal calls '(modern))))
        (setq gui nil)
        (let ((jb-gui-presentation-active nil))
          (jb-markdown-apply-presentation)
          (should (eq major-mode 'gfm-mode))
          (jb-markdown-apply-presentation)
          (should (equal calls '(gfm modern))))
        (dolist (file '("/tmp/notes.md" "/tmp/notes.markdown"))
          (setq buffer-file-name file)
          (jb-markdown-select-mode)
          (should (eq major-mode 'markdown-mode)))
        (setq gui t)
        (let ((jb-gui-presentation-active t))
          (jb-markdown-apply-presentation)
          (should (eq major-mode 'markdown-modern-mode)))
        (should (equal calls '(modern markdown markdown gfm modern)))))))

(ert-deftest jb-markdown-refresh-ignores-other-buffers ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/file.txt" major-mode 'markdown-mode)
    (cl-letf (((symbol-function 'jb-markdown-select-mode)
               (lambda () (ert-fail "Non-Markdown file was switched"))))
      (jb-markdown-apply-presentation))))

(ert-deftest jb-gui-frame-transition-refreshes-agendas-and-scrolling ()
  (let ((jb-gui-presentation-active nil) (pixel-scroll-precision-mode nil)
        (gui t) (redraws 0) scroll-arguments)
    (cl-letf (((symbol-function 'jb-gui-presentation-eligible-p) (lambda (&optional _) gui))
              ((symbol-function 'buffer-list) (lambda () nil))
              ((symbol-function 'pixel-scroll-precision-mode)
               (lambda (arg) (push arg scroll-arguments)
                 (setq pixel-scroll-precision-mode (> arg 0))))
              ((symbol-function 'org-agenda-redo-all)
               (lambda (&optional exhaustive)
                 (should exhaustive)
                 (cl-incf redraws))))
      (jb-refresh-gui-presentation)
      (jb-refresh-gui-presentation)
      (setq gui nil)
      (jb-refresh-gui-presentation)
      (should (= redraws 2))
      (should (equal scroll-arguments '(-1 1)))
      (should-not pixel-scroll-precision-mode))))

(ert-deftest jb-org-agenda-only-styled-in-gui-profile ()
  (let ((calls 0))
    (cl-letf (((symbol-function 'org-modern-agenda) (lambda () (cl-incf calls))))
      (let ((jb-gui-presentation-active nil)) (jb-org-agenda-apply-presentation))
      (should (= calls 0))
      (let ((jb-gui-presentation-active t)) (jb-org-agenda-apply-presentation))
      (should (= calls 1)))))
