#!/usr/bin/env bash

if [[ -n "${ZELLIJ_SESSIONIZER_SEARCH_PATHS:-}" ]]; then
  # Space-delimited list from env, e.g. "/path/one /path/two"
  # shellcheck disable=SC2206
  SEARCH_PATHS=(${ZELLIJ_SESSIONIZER_SEARCH_PATHS})
else
  SEARCH_PATHS=("$HOME/repos" "$HOME/code" "/Users/jay.bonthius/Code")
fi
SPECIFIC_PATHS=(${ZELLIJ_SESSIONIZER_SPECIFIC_PATHS:-"$HOME/dotfiles"})
OS_TYPE="${ZELLIJ_SESSIONIZER_OS_TYPE:-"$(uname)"}"
ZELLIJ_TAB_STATE_DIR="${ZELLIJ_SESSIONIZER_STATE_DIR:-$HOME/.local/state/zellij-tab-state}"
export ZELLIJ_SESSIONIZER_STATE_DIR="$ZELLIJ_TAB_STATE_DIR"
SESSION_OPEN_CMD="${ZELLIJ_SESSION_OPEN_CMD:-zellij-session-open}"
SESSION_NAME_CMD="${ZELLIJ_SESSION_NAME_CMD:-zellij-session-name}"

COLOR_ACTIVE=$'\033[33m'
COLOR_EXITED=$'\033[31m'
COLOR_RESET=$'\033[0m'

ACTIVE_ONLY=false
GENERATE_LIST=false
GENERATE_ACTIVE_LIST=false
FORCE_FRESH=false

for arg in "$@"; do
  case "$arg" in
    --active) ACTIVE_ONLY=true ;;
    --fresh|-f) FORCE_FRESH=true ;;
    --generate-list) GENERATE_LIST=true ;;
    --generate-active-list) GENERATE_ACTIVE_LIST=true ;;
  esac
done

if ! command -v "$SESSION_OPEN_CMD" >/dev/null 2>&1; then
  echo "zellij-sessionizer: session opener not found: $SESSION_OPEN_CMD" >&2
  exit 1
fi

get_atime() {
  local dir="$1"
  if [[ "$OS_TYPE" == "Linux" ]]; then
    stat -c "%X" "$dir" 2>/dev/null || echo "0"
  else
    stat -f "%a" "$dir" 2>/dev/null || echo "0"
  fi
}

strip_status_suffix() {
  local display_line="$1"
  echo "$display_line" | sed -E $'s/[[:space:]]+\x1B\\[[0-9;]*m\((active|exited)\)\x1B\\[0m$//; s/[[:space:]]+\((active|exited)\)$//'
}

session_name_for_dir() {
  local dir="$1"
  if command -v "$SESSION_NAME_CMD" >/dev/null 2>&1; then
    "$SESSION_NAME_CMD" "$dir"
  else
    basename "$dir"
  fi
}

extract_session_name() {
  local display_line="$1"
  local clean_path
  clean_path=$(strip_status_suffix "$display_line")

  if [[ "$clean_path" == ~* || "$clean_path" == /* ]]; then
    local full_path
    if [[ "$clean_path" == ~* ]]; then
      full_path="$HOME${clean_path:1}"
    else
      full_path="$clean_path"
    fi
    session_name_for_dir "$full_path"
  else
    echo "$clean_path"
  fi
}

display_to_full_path() {
  local display_line="$1"
  local clean_path
  clean_path=$(strip_status_suffix "$display_line")

  if [[ "$clean_path" == ~* ]]; then
    echo "$HOME${clean_path:1}"
  else
    echo "$clean_path"
  fi
}

generate_active_list() {
  if ! command -v zellij >/dev/null 2>&1; then
    return 0
  fi

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue

    local session_name="${line%% *}"

    if [[ "$line" == *"(current)"* ]]; then
      continue
    elif [[ "$line" == *"(EXITED"* ]]; then
      echo "$session_name ${COLOR_EXITED}(exited)${COLOR_RESET}"
    else
      echo "$session_name ${COLOR_ACTIVE}(active)${COLOR_RESET}"
    fi
  done < <(zellij ls -n 2>/dev/null)
}

generate_display_list() {
  local all_dirs=()
  declare -A seen=()

  for search_path in "${SEARCH_PATHS[@]}"; do
    if [[ -d "$search_path" ]]; then
      for dir in "$search_path"/*; do
        if [[ -d "$dir" && -z "${seen[$dir]}" ]]; then
          all_dirs+=("$dir")
          seen["$dir"]=1
        fi
      done
    fi
  done

  for specific_path in "${SPECIFIC_PATHS[@]}"; do
    if [[ -d "$specific_path" && -z "${seen[$specific_path]}" ]]; then
      all_dirs+=("$specific_path")
      seen["$specific_path"]=1
    fi
  done

  local sorted_dirs=()
  if [[ ${#all_dirs[@]} -gt 0 ]]; then
    local temp_file
    temp_file=$(mktemp)

    for dir in "${all_dirs[@]}"; do
      local atime
      atime=$(get_atime "$dir")
      printf '%s\t%s\n' "$atime" "$dir" >> "$temp_file"
    done

    while IFS=$'\t' read -r _ dir_name; do
      sorted_dirs+=("$dir_name")
    done < <(sort -nr -k1,1 "$temp_file")

    rm -f "$temp_file"
  fi

  declare -A session_status
  local current_session=""
  if command -v zellij >/dev/null 2>&1; then
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue

      local session_name="${line%% *}"

      if [[ "$line" == *"(current)"* ]]; then
        current_session="$session_name"
      elif [[ "$line" == *"(EXITED"* ]]; then
        session_status["$session_name"]=" ${COLOR_EXITED}(exited)${COLOR_RESET}"
      else
        session_status["$session_name"]=" ${COLOR_ACTIVE}(active)${COLOR_RESET}"
      fi
    done < <(zellij ls -n 2>/dev/null)
  fi

  for dir in "${sorted_dirs[@]}"; do
    local session_name
    session_name=$(session_name_for_dir "$dir")

    [[ "$session_name" == "$current_session" ]] && continue

    local display_name
    display_name=$(echo "$dir" | sed "s|^$HOME|~|")

    if [[ -n "${session_status[$session_name]}" ]]; then
      display_name="${display_name}${session_status[$session_name]}"
    fi

    echo "$display_name"
  done
}

# Fast paths for fzf reload actions
if [[ "$GENERATE_ACTIVE_LIST" == true ]]; then
  generate_active_list
  exit 0
fi

if [[ "$GENERATE_LIST" == true ]]; then
  generate_display_list
  exit 0
fi

SELF_PATH="${BASH_SOURCE[0]}"

# Temporary script used by fzf keybindings (delete/kill + tab-state cleanup)
temp_script=$(mktemp)
trap 'rm -f "$temp_script"' EXIT
export ZELLIJ_SESSION_OPEN_CMD="$SESSION_OPEN_CMD"
export ZELLIJ_SESSION_NAME_CMD="$SESSION_NAME_CMD"
cat > "$temp_script" << 'EOF'
#!/usr/bin/env bash

STATE_DIR="${ZELLIJ_SESSIONIZER_STATE_DIR:-$HOME/.local/state/zellij-tab-state}"
SESSION_DIR_STATE_DIR="${ZELLIJ_SESSION_DIR_STATE_DIR:-$HOME/.local/state/zellij-session-dir}"
OPEN_CMD="${ZELLIJ_SESSION_OPEN_CMD:-zellij-session-open}"
NAME_CMD="${ZELLIJ_SESSION_NAME_CMD:-zellij-session-name}"

strip_status_suffix() {
  local display_line="$1"
  echo "$display_line" | sed -E $'s/[[:space:]]+\x1B\\[[0-9;]*m\((active|exited)\)\x1B\\[0m$//; s/[[:space:]]+\((active|exited)\)$//'
}

session_name_for_dir() {
  local dir="$1"
  if command -v "$NAME_CMD" >/dev/null 2>&1; then
    "$NAME_CMD" "$dir"
  else
    basename "$dir"
  fi
}

extract_session_name() {
  local display_line="$1"
  local clean_path
  clean_path=$(strip_status_suffix "$display_line")

  if [[ "$clean_path" == ~* || "$clean_path" == /* ]]; then
    local full_path
    if [[ "$clean_path" == ~* ]]; then
      full_path="$HOME${clean_path:1}"
    else
      full_path="$clean_path"
    fi
    session_name_for_dir "$full_path"
  else
    echo "$clean_path"
  fi
}

display_to_full_path() {
  local display_line="$1"
  local clean_path
  clean_path=$(strip_status_suffix "$display_line")

  if [[ "$clean_path" == ~* ]]; then
    echo "$HOME${clean_path:1}"
  else
    echo "$clean_path"
  fi
}

remove_tab_state() {
  local session_name="$1"
  [[ -z "$session_name" ]] && return
  rm -f "$STATE_DIR/$session_name" 2>/dev/null
  rm -f "$SESSION_DIR_STATE_DIR/$session_name" 2>/dev/null
}

if [[ "$1" == "delete" ]]; then
  session_name=$(extract_session_name "$2")
  if [[ -n "$session_name" ]]; then
    zellij delete-session "$session_name" --force 2>/dev/null
    remove_tab_state "$session_name"
  fi
fi

if [[ "$1" == "kill" ]]; then
  session_name=$(extract_session_name "$2")
  if [[ -n "$session_name" ]]; then
    zellij kill-session "$session_name" 2>/dev/null
    remove_tab_state "$session_name"
  fi
fi

if [[ "$1" == "recreate" ]]; then
  target_dir=$(display_to_full_path "$2")
  if [[ -d "$target_dir" ]] && command -v "$OPEN_CMD" >/dev/null 2>&1; then
    session_name=$(session_name_for_dir "$target_dir")
    "$OPEN_CMD" --fresh --name "$session_name" --dir "$target_dir" >/dev/null 2>&1 || true
  else
    session_name=$(extract_session_name "$2")
    zellij delete-session "$session_name" --force 2>/dev/null || true
    remove_tab_state "$session_name"
  fi
fi
EOF
chmod +x "$temp_script"

# Active sessions mode — show only running/exited sessions and switch directly.
if [[ "$ACTIVE_ONLY" == true ]]; then
  if [[ "$FORCE_FRESH" == true ]]; then
    echo "zellij-sessionizer: --fresh is only supported for project list mode" >&2
  fi

  selected=$(generate_active_list | fzf --ansi \
    --prompt="Switch session: " \
    --header="Enter: Switch | Ctrl+D: Delete Session | Ctrl+K: Kill Session" \
    --bind="ctrl-d:execute($temp_script delete {})+reload(bash '$SELF_PATH' --generate-active-list)" \
    --bind="ctrl-k:execute($temp_script kill {})+reload(bash '$SELF_PATH' --generate-active-list)")

  if [[ -z "$selected" ]]; then
    exit 0
  fi

  session_name=$(extract_session_name "$selected")
  "$SESSION_OPEN_CMD" --name "$session_name"
  exit 0
fi

selected_display=$(generate_display_list | fzf --ansi \
  --prompt="Select project: " \
  --header="Enter: Select | Ctrl+R: Recreate Session | Ctrl+D: Delete | Ctrl+K: Kill" \
  --bind="ctrl-r:execute($temp_script recreate {})+reload(bash '$SELF_PATH' --generate-list)" \
  --bind="ctrl-d:execute($temp_script delete {})+reload(bash '$SELF_PATH' --generate-list)" \
  --bind="ctrl-k:execute($temp_script kill {})+reload(bash '$SELF_PATH' --generate-list)")

if [[ -z "$selected_display" ]]; then
  exit 0
fi

selected_dir=$(display_to_full_path "$selected_display")
session_name=$(session_name_for_dir "$selected_dir")

if [[ "$FORCE_FRESH" == true ]]; then
  "$SESSION_OPEN_CMD" --fresh --name "$session_name" --dir "$selected_dir"
else
  "$SESSION_OPEN_CMD" --name "$session_name" --dir "$selected_dir"
fi
