#!/usr/bin/env bash
set -euo pipefail

LAYOUT="project"
STATE_DIR="${ZELLIJ_SESSIONIZER_STATE_DIR:-$HOME/.local/state/zellij-tab-state}"
SESSION_DIR_STATE_DIR="${ZELLIJ_SESSION_DIR_STATE_DIR:-$HOME/.local/state/zellij-session-dir}"
SESSION_ACCESS_STATE_DIR="${ZELLIJ_SESSION_ACCESS_STATE_DIR:-$HOME/.local/state/zellij-session-access}"

SESSION_NAME=""
TARGET_DIR=""
FORCE_FRESH=false

usage() {
  cat <<'EOF'
Usage: zellij-session-open --name <session> [--dir <path>] [--fresh]

Unified session open/switch logic used by ws + zellij-sessionizer.
- New session: always created with layout "project".
- Workbench projects use the workbench root as the session cwd while Emacs
  keeps the selected nested project as its context.
- Existing session: switched/attached without reset.
- --fresh: explicit reset (delete + clear tab state) before opening.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name)
      SESSION_NAME="${2:-}"
      shift 2
      ;;
    --dir)
      TARGET_DIR="${2:-}"
      shift 2
      ;;
    --fresh|-f)
      FORCE_FRESH=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "zellij-session-open: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -n "$TARGET_DIR" ]]; then
  if [[ ! -d "$TARGET_DIR" ]]; then
    echo "zellij-session-open: not a directory: $TARGET_DIR" >&2
    exit 1
  fi
  if command -v realpath >/dev/null 2>&1; then
    TARGET_DIR="$(realpath "$TARGET_DIR")"
  else
    TARGET_DIR="$(cd "$TARGET_DIR" && pwd -P)"
  fi
fi

# The selected project remains TARGET_DIR so emacs-open-context can open it.
# For repos nested in the Gerbil workbench, start all other layout panes at the
# workbench root instead. This keeps Pi, terminal, and new tabs at the umbrella
# project while preserving one Zellij session per selected nested repo.
SESSION_CWD="$TARGET_DIR"
WORKBENCH_ROOT="$HOME/Code/workbench-gerbil"
if [[ -n "$TARGET_DIR" && -d "$WORKBENCH_ROOT" ]]; then
  if command -v realpath >/dev/null 2>&1; then
    WORKBENCH_ROOT="$(realpath "$WORKBENCH_ROOT")"
  else
    WORKBENCH_ROOT="$(cd "$WORKBENCH_ROOT" && pwd -P)"
  fi

  if [[ "$TARGET_DIR" == "$WORKBENCH_ROOT" || "$TARGET_DIR" == "$WORKBENCH_ROOT/"* ]]; then
    SESSION_CWD="$WORKBENCH_ROOT"
  fi
fi

if [[ -z "$SESSION_NAME" ]]; then
  if [[ -n "$TARGET_DIR" ]]; then
    if command -v zellij-session-name >/dev/null 2>&1; then
      SESSION_NAME="$(zellij-session-name "$TARGET_DIR")"
    else
      SESSION_NAME="$(basename "$TARGET_DIR")"
    fi
  else
    echo "zellij-session-open: --name is required when --dir is omitted" >&2
    exit 1
  fi
fi

# NOTE: no process lock here. Previous lock attempts caused stale-lock no-op behavior.

session_state() {
  # Prints one of: active | exited | current | none
  local target="$1"
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local session_name="${line%% *}"
    if [[ "$session_name" == "$target" ]]; then
      if [[ "$line" == *"(current)"* ]]; then
        echo "current"
      elif [[ "$line" == *"(EXITED"* ]]; then
        echo "exited"
      else
        echo "active"
      fi
      return 0
    fi
  done < <(zellij ls -n 2>/dev/null)
  echo "none"
}

clear_saved_focus() {
  rm -f "$STATE_DIR/$SESSION_NAME" 2>/dev/null || true
}

session_dir_state_path() {
  local session="$1"
  echo "$SESSION_DIR_STATE_DIR/$session"
}

save_session_dir_state() {
  local session="$1"
  local dir="$2"
  [[ -n "$dir" ]] || return 0
  mkdir -p "$SESSION_DIR_STATE_DIR"
  printf '%s\n' "$dir" > "$(session_dir_state_path "$session")"
}

load_session_dir_state() {
  local session="$1"
  local path
  path="$(session_dir_state_path "$session")"
  [[ -f "$path" ]] || return 1
  head -n1 "$path"
}

clear_session_dir_state() {
  rm -f "$(session_dir_state_path "$SESSION_NAME")" 2>/dev/null || true
}

session_access_state_path() {
  local session="$1"
  echo "$SESSION_ACCESS_STATE_DIR/$session"
}

touch_session_access_state() {
  local session="$1"
  [[ -n "$session" ]] || return 0
  mkdir -p "$SESSION_ACCESS_STATE_DIR"
  touch "$(session_access_state_path "$session")"
}

clear_session_access_state() {
  rm -f "$(session_access_state_path "$SESSION_NAME")" 2>/dev/null || true
}

delete_session_if_exists() {
  zellij delete-session "$SESSION_NAME" --force >/dev/null 2>&1 || true
}

save_focus_state() {
  local session="$1"
  local tab_position="$2"
  local pane_token="${3:-}"

  mkdir -p "$STATE_DIR"
  {
    echo "tab=$tab_position"
    if [[ -n "$pane_token" ]]; then
      echo "pane=$pane_token"
    fi
  } > "$STATE_DIR/$session"
}

capture_current_focus() {
  local current_session="$1"
  [[ -n "$current_session" ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  local tab_json tab_position
  tab_json="$(zellij action current-tab-info --json 2>/dev/null || true)"
  tab_position="$(printf '%s' "$tab_json" | jq -r '.position // empty' 2>/dev/null || true)"
  [[ -n "$tab_position" ]] || return 0

  local pane_token=""
  local panes_json
  panes_json="$(zellij action list-panes --json --state --tab 2>/dev/null || true)"
  if [[ -n "$panes_json" ]]; then
    pane_token="$(printf '%s' "$panes_json" | jq -r --argjson tab "$tab_position" '
      map(select(.tab_position == $tab and .is_focused == true))
      | first
      | if . == null then empty else (if .is_plugin then "plugin:" else "terminal:" end) + (.id|tostring) end
    ' 2>/dev/null || true)"
  fi

  save_focus_state "$current_session" "$tab_position" "$pane_token"
}

load_focus_state() {
  local session="$1"
  local path="$STATE_DIR/$session"
  [[ -f "$path" ]] || return 1

  LOADED_TAB=""
  LOADED_PANE=""

  while IFS='=' read -r key value; do
    case "$key" in
      tab)  LOADED_TAB="$value" ;;
      pane) LOADED_PANE="$value" ;;
    esac
  done < "$path"

  [[ -n "$LOADED_TAB" || -n "$LOADED_PANE" ]]
}

pane_token_to_cli_pane_id() {
  local token="$1"
  case "$token" in
    terminal:*) echo "terminal_${token#terminal:}" ;;
    plugin:*)   echo "plugin_${token#plugin:}" ;;
    *)          return 1 ;;
  esac
}

switch_existing_inside() {
  local target_session="$1"

  local pane_cli_id=""
  if load_focus_state "$target_session" && [[ -n "$LOADED_PANE" ]]; then
    pane_cli_id="$(pane_token_to_cli_pane_id "$LOADED_PANE" 2>/dev/null || true)"
  fi

  # Safer switching path: avoid tab-position during session switch.
  # We've seen active-tab race errors during rapid switching.
  zellij action switch-session "$target_session"

  if [[ -n "$pane_cli_id" ]]; then
    # Give zellij a moment to settle after switch, then try restoring pane focus.
    sleep 0.06
    local _
    for _ in 1 2 3; do
      zellij action focus-pane-id "$pane_cli_id" >/dev/null 2>&1 && break
      sleep 0.05
    done
  fi

  touch_session_access_state "$target_session"
}

start_new_session() {
  save_session_dir_state "$SESSION_NAME" "$TARGET_DIR"
  touch_session_access_state "$SESSION_NAME"
  zellij -l "$LAYOUT" options \
    --session-name "$SESSION_NAME" \
    --default-cwd "$SESSION_CWD"
}

create_and_switch_inside() {
  # Let zellij create-or-switch with explicit layout/cwd.
  # Retry briefly to smooth over transient switch races.
  local _
  for _ in 1 2 3; do
    if zellij action switch-session "$SESSION_NAME" --layout "$LAYOUT" --cwd "$SESSION_CWD" >/dev/null 2>&1; then
      touch_session_access_state "$SESSION_NAME"
      return 0
    fi
    sleep 0.05
  done

  echo "zellij-session-open: failed to create/switch session '$SESSION_NAME' with cwd '$SESSION_CWD'" >&2
  return 1
}

current_state="$(session_state "$SESSION_NAME")"

if [[ "$FORCE_FRESH" != true && "$current_state" != "none" && -n "$TARGET_DIR" ]]; then
  stored_target_dir="$(load_session_dir_state "$SESSION_NAME" 2>/dev/null || true)"
  if [[ -n "$stored_target_dir" && "$stored_target_dir" != "$TARGET_DIR" ]]; then
    FORCE_FRESH=true
  fi
fi

if [[ "$FORCE_FRESH" == true && "$current_state" != "none" ]]; then
  # Deleting the current session from inside itself is risky; refuse.
  if [[ -n "${ZELLIJ:-}" && "$current_state" == "current" ]]; then
    echo "zellij-session-open: refusing --fresh on the current attached session ('$SESSION_NAME')" >&2
    exit 1
  fi

  delete_session_if_exists
  clear_saved_focus
  clear_session_dir_state
  clear_session_access_state
  current_state="none"
fi

if [[ -n "${ZELLIJ:-}" ]]; then
  # No-op guard: avoid switching to current session repeatedly.
  if [[ "$current_state" == "current" ]]; then
    touch_session_access_state "$SESSION_NAME"
    exit 0
  fi

  # Save focus for the current session before leaving it.
  current_session_name="$(zellij ls -n 2>/dev/null | awk '/\(current\)/ { print $1; exit }')"
  capture_current_focus "$current_session_name"

  if [[ "$current_state" == "none" ]]; then
    if [[ -z "$TARGET_DIR" ]]; then
      echo "zellij-session-open: cannot create missing session '$SESSION_NAME' without --dir" >&2
      exit 1
    fi

    save_session_dir_state "$SESSION_NAME" "$TARGET_DIR"
    create_and_switch_inside
  else
    if [[ -n "$TARGET_DIR" ]]; then
      save_session_dir_state "$SESSION_NAME" "$TARGET_DIR"
    fi
    switch_existing_inside "$SESSION_NAME"
  fi
else
  # Outside zellij: attach existing, create missing with project layout.
  if [[ "$current_state" == "none" ]]; then
    if [[ -z "$TARGET_DIR" ]]; then
      echo "zellij-session-open: cannot create missing session '$SESSION_NAME' without --dir" >&2
      exit 1
    fi
    start_new_session
  else
    if [[ -n "$TARGET_DIR" ]]; then
      save_session_dir_state "$SESSION_NAME" "$TARGET_DIR"
    fi
    touch_session_access_state "$SESSION_NAME"
    zellij attach "$SESSION_NAME"
  fi
fi
