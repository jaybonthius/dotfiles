// Personal-machine project layout for zellij.
// Deployed as project.kdl on non-work machines (see home.nix isWorkMachine).
// Usage: ws <directory> [session-name]
//
// Tab 1: terminal Emacs
// Tab 2: pi coding agent
// Tab 3: terminal

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    new_tab_template {
        pane
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    tab name="editor" focus=true {
        pane command="emacs" {
            args "-nw"
        }
    }

    tab name="pi" {
        pane command="pi"
    }

    tab name="terminal" {
        pane
    }
}
