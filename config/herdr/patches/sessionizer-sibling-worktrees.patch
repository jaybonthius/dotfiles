+const temporaryDirectories: string[] = [];
+
+afterEach(() => {
+  for (const directory of temporaryDirectories.splice(0)) {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+function git(cwd: string, ...args: string[]): string {
+  const result = Bun.spawnSync(["git", "-C", cwd, ...args]);
+  if (result.exitCode !== 0) throw new Error(result.stderr.toString());
+  return result.stdout.toString();
+}
+
+function fixture() {
+  const parent = mkdtempSync(join(tmpdir(), "sessionizer-sibling-"));
+  temporaryDirectories.push(parent);
+  // Exercise spaces and quoting rather than relying on porcelain line parsing.
+  const repo = join(parent, 'My "Repo"');
+  mkdirSync(repo);
+  git(repo, "init", "-b", "main");
+  git(
+    repo,
+    "-c",
+    "user.name=Test",
+    "-c",
+    "user.email=test@example.invalid",
+    "-c",
+    "commit.gpgsign=false",
+    "commit",
+    "--allow-empty",
+    "-m",
+    "initial"
+  );
+  return { parent, repo };
+}
+
+describe("resolveSiblingWorktreePath", () => {
+  it("uses a sibling directory and preserves branch spelling except slashes", async () => {
+    const { parent, repo } = fixture();
+    expect(await resolveSiblingWorktreePath(repo, "Feature/UI_fix.v2")).toBe(
+      join(parent, 'My "Repo"__Feature-UI_fix.v2')
+    );
+  });
+
+  it("resolves the main repo when invoked from a linked worktree subdirectory", async () => {
+    const { parent, repo } = fixture();
+    const linked = join(parent, "old-location");
+    git(repo, "worktree", "add", "-b", "first", linked);
+    const nested = join(linked, "nested");
+    mkdirSync(nested);
+    expect(await resolveSiblingWorktreePath(nested, "second")).toBe(
+      join(parent, 'My "Repo"__second')
+    );
+  });
+
+  it("supports a bare repository", async () => {
+    const { parent, repo } = fixture();
+    const bare = join(parent, "bare.git");
+    git(repo, "clone", "--bare", repo, bare);
+    expect(await resolveSiblingWorktreePath(bare, "feature/test")).toBe(
+      join(parent, "bare.git__feature-test")
+    );
+  });
+
+  it("rejects a directory outside a repository", async () => {
+    const { parent } = fixture();
+    await expect(
+      resolveSiblingWorktreePath(parent, "feature")
+    ).rejects.toThrow();
+  });
+});

