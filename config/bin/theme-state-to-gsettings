#!/usr/bin/env bash
set -euo pipefail

THEME_FILE="${HOME}/.local/state/theme"

# We only sync explicit dark/light values.
if [[ ! -f "$THEME_FILE" ]]; then
  exit 0
fi

mode="$(tr -d '\r' < "$THEME_FILE" | head -n1 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
case "$mode" in
  dark)
    color_scheme="prefer-dark"
    gtk_theme="Adwaita-dark"
    tmux_theme="modus_vivendi_tinted.tmux"
    ;;
  light)
    color_scheme="prefer-light"
    gtk_theme="Adwaita"
    tmux_theme="modus_operandi_tinted.tmux"
    ;;
  *)
    exit 0
    ;;
esac

# Re-theme an existing tmux server without starting one just for the sync.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "${HOME}/.config/tmux/themes/${tmux_theme}" >/dev/null 2>&1 || true
fi

# gsettings requires a user bus; in non-GUI/headless sessions this may be absent.
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
  exit 0
fi

if ! command -v gsettings >/dev/null 2>&1; then
  exit 0
fi

# GNOME 42+ color-scheme key.
gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" >/dev/null 2>&1 || true
# Backward-compatible hint for apps still reading gtk-theme.
gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" >/dev/null 2>&1 || true
