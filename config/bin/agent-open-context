#!/usr/bin/env bash
set -euo pipefail

agent="${1:?Usage: agent-open-context AGENT [DIRECTORY]}"
target="$(cd "${2:-$PWD}" && pwd -P)"
dir="$target"

while [[ "$dir" != "/" ]]; do
  case "${dir##*/}" in
    workbench-*|*-workbench)
      cd "$dir"
      exec "$agent"
      ;;
  esac

  dir="${dir%/*}"
  [[ -n "$dir" ]] || dir="/"
done

cd "$target"
exec "$agent"
