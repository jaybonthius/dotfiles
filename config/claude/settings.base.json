{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "Grep",
      "Glob",
      "LS",
      "MultiEdit",
      "NotebookRead",
      "NotebookEdit",
      "TodoRead",
      "TodoWrite",
      "WebSearch",
      "WebFetch(domain:codeberg.org)",
      "WebSearch",
      "WebFetch(domain:elpa.nongnu.org)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [],
    "ask": [],
