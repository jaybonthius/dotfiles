#!/usr/bin/env bash
# claude-open-context: launch claude scoped to a project's agent working directory.
#
# Repos that live inside an agent workbench get claude launched from the workbench
# root -- that's where the workbench's own claude config, plugins and specs live,
# and it's the directory the agent is meant to work from. Every other project
# launches claude in the project directory itself.
#
# Usage:
#   claude-open-context [DIR]
#
# DIR defaults to the current session's project directory, then the pane cwd.
#
# Config:
#   AGENT_WORKBENCH_ROOTS  space-delimited workbench roots, e.g. "/path/one /path/two"
set -euo pipefail

if [[ -n "${AGENT_WORKBENCH_ROOTS:-}" ]]; then
  # Space-delimited list from env, e.g. "/path/one /path/two"
  # shellcheck disable=SC2206
  WORKBENCH_ROOTS=(${AGENT_WORKBENCH_ROOTS})
else
  WORKBENCH_ROOTS=("$HOME/vdr-agentic-workbench")
fi

TARGET_DIR="${1:-}"

if [[ -z "$TARGET_DIR" ]]; then
  # Prefer per-session project dir (set by zellij-session-open), then fall back to pane cwd.
  session_name="${ZELLIJ_SESSION_NAME:-}"
  if [[ -z "$session_name" && -n "${ZELLIJ:-}" ]]; then
    session_name="$(zellij ls -n 2>/dev/null | awk '/\(current\)/ { print $1; exit }' || true)"
  fi

  if [[ -n "$session_name" ]]; then
    SESSION_DIR_STATE_DIR="${ZELLIJ_SESSION_DIR_STATE_DIR:-$HOME/.local/state/zellij-session-dir}"
    session_dir_file="$SESSION_DIR_STATE_DIR/$session_name"
    if [[ -f "$session_dir_file" ]]; then
      TARGET_DIR="$(head -n1 "$session_dir_file" 2>/dev/null || true)"
    fi
  fi
fi

TARGET_DIR="${TARGET_DIR:-$PWD}"

if [[ ! -d "$TARGET_DIR" ]]; then
  echo "claude-open-context: not a directory: $TARGET_DIR" >&2
  exit 1
fi

normalize_dir() {
  local dir="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath "$dir"
  else
    (cd "$dir" && pwd -P)
  fi
}

TARGET_DIR="$(normalize_dir "$TARGET_DIR")"

# Redirect to the enclosing workbench root, if the project sits inside one.
if [[ ${#WORKBENCH_ROOTS[@]} -gt 0 ]]; then
  for root in "${WORKBENCH_ROOTS[@]}"; do
    [[ -d "$root" ]] || continue
    root="$(normalize_dir "$root")"
    if [[ "$TARGET_DIR" == "$root" || "$TARGET_DIR" == "$root"/* ]]; then
      TARGET_DIR="$root"
      break
    fi
  done
fi

cd "$TARGET_DIR"
exec claude
