#!/usr/bin/env bash
# emacs-open-context: open an Emacs client frame scoped to a directory context.
#
# Usage:
#   emacs-open-context [DIR] [INTENT]
#
# DIR defaults to current working directory.
# INTENT defaults to "project".
set -euo pipefail

TARGET_DIR="${1:-}"
INTENT="${2:-project}"

if [[ -z "$TARGET_DIR" ]]; then
  # Prefer per-session project dir (set by zellij-session-open), then fall back to pane cwd.
  session_name="${ZELLIJ_SESSION_NAME:-}"
  if [[ -z "$session_name" && -n "${ZELLIJ:-}" ]]; then
    session_name="$(zellij ls -n 2>/dev/null | awk '/\(current\)/ { print $1; exit }' || true)"
  fi

  if [[ -n "$session_name" ]]; then
    SESSION_DIR_STATE_DIR="${ZELLIJ_SESSION_DIR_STATE_DIR:-$HOME/.local/state/zellij-session-dir}"
    session_dir_file="$SESSION_DIR_STATE_DIR/$session_name"
    if [[ -f "$session_dir_file" ]]; then
      TARGET_DIR="$(head -n1 "$session_dir_file" 2>/dev/null || true)"
    fi
  fi
fi

TARGET_DIR="${TARGET_DIR:-$PWD}"

if [[ ! -d "$TARGET_DIR" ]]; then
  echo "emacs-open-context: not a directory: $TARGET_DIR" >&2
  exit 1
fi

if command -v realpath >/dev/null 2>&1; then
  TARGET_DIR="$(realpath "$TARGET_DIR")"
else
  TARGET_DIR="$(cd "$TARGET_DIR" && pwd -P)"
fi

case "$INTENT" in
  project|dired|files) ;;
  *)
    echo "emacs-open-context: unsupported intent '$INTENT' (expected: project|dired|files)" >&2
    exit 1
    ;;
esac

lisp_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/ }"
  printf '%s' "$s"
}

ESCAPED_DIR="$(lisp_escape "$TARGET_DIR")"
SOCKET_NAME="${EMACS_SOCKET_NAME:-server}"

if [[ "$SOCKET_NAME" == */* ]]; then
  SOCKET_ARG="$SOCKET_NAME"
elif [[ -n "${XDG_RUNTIME_DIR:-}" && -S "$XDG_RUNTIME_DIR/emacs/$SOCKET_NAME" ]]; then
  SOCKET_ARG="$XDG_RUNTIME_DIR/emacs/$SOCKET_NAME"
else
  SOCKET_ARG="$SOCKET_NAME"
fi

ELISP_EXPR="(jb-open-context \"$ESCAPED_DIR\" '$INTENT)"
exec emacsclient -s "$SOCKET_ARG" -t --eval "$ELISP_EXPR"
