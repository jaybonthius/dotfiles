# Fictional service: synchronous reads and asynchronous jobs.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}
direction: right

classes: {
  service: {
    style: {
      fill: "#e8f0fe"
      stroke: "#355c96"
      font-color: "#172b4d"
      border-radius: 8
    }
  }
}

client: Client
application: Application {
  api: API {class: service}
  worker: Worker {class: service}
  queue: Job queue {shape: queue}
  database: Database {shape: cylinder}

  api -> database: read / write
  api -> queue: enqueue job
  queue -> worker: deliver job
  worker -> database: save result
}
client -> application.api: HTTPS
